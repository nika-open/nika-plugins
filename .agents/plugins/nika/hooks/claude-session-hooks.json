{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -p \"${CLAUDE_PLUGIN_ROOT}\"/scripts/session-status.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -p \"${CLAUDE_PLUGIN_ROOT}\"/scripts/intent-hint.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -p \"${CLAUDE_PLUGIN_ROOT}\"/scripts/stop-gate.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^nika:nika-author$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -p \"${CLAUDE_PLUGIN_ROOT}\"/scripts/python-hook.sh author-stop-gate.py",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -p \"${CLAUDE_PLUGIN_ROOT}\"/scripts/python-hook.sh run-failed-hint.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -p \"${CLAUDE_PLUGIN_ROOT}\"/scripts/python-hook.sh precompact-notes.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
