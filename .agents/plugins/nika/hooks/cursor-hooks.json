{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "/bin/bash -p ./scripts/session-context.sh"
      }
    ],
    "afterFileEdit": [
      {
        "command": "/bin/bash -p ./scripts/check-on-edit.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "/bin/bash -p ./scripts/guard-run.sh",
        "timeout": 30
      }
    ]
  }
}
